---
const current = Astro.url.pathname;
const links = [
  { href: '/#features', label: 'Features' },
  { href: '/docs', label: 'Documentation' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
];
---
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="STREAM AUTH home"><span class="brand-mark">S</span><span>STREAM AUTH</span></a>
    <nav class="nav-links" aria-label="Main navigation">
      {links.map((link) => <a href={link.href} class:list={[current === link.href ? 'active' : '']}>{link.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="text-link" href="/dashboard">Login</a>
      <a class="button button-small" href="/dashboard">Get Started <span aria-hidden="true">↗</span></a>
    </div>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu <span>+</span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href="/dashboard">Get started</a>
      </nav>
    </details>
  </div>
</header>
