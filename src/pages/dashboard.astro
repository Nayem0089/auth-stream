---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dashboard Preview — STREAM AUTH" description="A preview of the Stream Auth dashboard for license and authentication management." path="/dashboard">
  <section class="dashboard-page"><div class="shell"><div class="dashboard-page-head"><div><p class="eyebrow">DASHBOARD PREVIEW</p><h1>Your software, protected.</h1><p>Monitor authentication, manage licenses, and keep your team in the loop.</p></div><button class="button">+ Create license</button></div>
    <div class="app-selector"><div><span class="app-icon">SA</span><div><b>Arcade Studio</b><small>Production</small></div><span class="chevron">⌄</span></div><button>•••</button></div>
    <div class="dashboard-kpis"><article><span>Active licenses</span><strong>12,486</strong><small>↗ 12.5% <em>vs. last month</em></small></article><article><span>Active users</span><strong>8,291</strong><small>↗ 4.8% <em>vs. last month</em></small></article><article><span>API requests</span><strong>1.2M</strong><small>↗ 8.2% <em>vs. last month</em></small></article><article><span>Success rate</span><strong>99.98%</strong><small>● <em>All systems operational</em></small></article></div>
    <div class="dashboard-main-grid"><section class="request-graph"><div class="panel-title"><div><h2>Authentication requests</h2><p>Volume over the last 30 days</p></div><button>Last 30 days⌄</button></div><div class="wide-chart"><svg viewBox="0 0 800 250" preserveAspectRatio="none" aria-label="Request volume chart"><defs><linearGradient id="fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#111" stop-opacity=".2"/><stop offset="100%" stop-color="#111" stop-opacity="0"/></linearGradient></defs><path d="M0,190 C35,180 43,145 72,157 S121,105 153,132 S212,100 244,114 S290,78 330,105 S390,119 421,70 S476,112 512,96 S560,50 600,76 S653,27 690,59 S749,24 800,40 V250 H0Z" fill="url(#fill)"/><path d="M0,190 C35,180 43,145 72,157 S121,105 153,132 S212,100 244,114 S290,78 330,105 S390,119 421,70 S476,112 512,96 S560,50 600,76 S653,27 690,59 S749,24 800,40" fill="none" stroke="#111" stroke-width="3"/></svg><div class="chart-labels"><span>Jul 1</span><span>Jul 7</span><span>Jul 14</span><span>Jul 21</span><span>Jul 30</span></div></div></section>
      <section class="quick-panel"><div class="panel-title"><div><h2>Quick actions</h2><p>Common tasks</p></div></div><a href="/docs"><b>+</b><span>Create a license<small>Issue a new key</small></span><i>→</i></a><a href="/docs"><b>⌘</b><span>View API keys<small>Manage credentials</small></span><i>→</i></a><a href="/docs"><b>◈</b><span>Invite a teammate<small>Collaborate securely</small></span><i>→</i></a></section>
    </div>
    <section class="licenses-table"><div class="panel-title"><div><h2>Recent licenses</h2><p>Latest activity across your application</p></div><a href="/docs">View all →</a></div><div class="table-scroll"><table><thead><tr><th>LICENSE KEY</th><th>CUSTOMER</th><th>STATUS</th><th>ACTIVATED</th><th>PLAN</th></tr></thead><tbody><tr><td><code>••••-••••-9K2P</code></td><td>Sarah Chen</td><td><span class="badge success">Active</span></td><td>Just now</td><td>Pro</td></tr><tr><td><code>••••-••••-7LQ4</code></td><td>Marcus Reed</td><td><span class="badge success">Active</span></td><td>12 min ago</td><td>Pro</td></tr><tr><td><code>••••-••••-3HD8</code></td><td>Olivia Park</td><td><span class="badge pending">Pending</span></td><td>—</td><td>Starter</td></tr></tbody></table></div></section>
  </div></section>
</BaseLayout>
