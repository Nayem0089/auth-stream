---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/blog';
---
<BaseLayout title="Blog — STREAM AUTH" description="Practical guides on software licensing, authentication APIs, and license management." path="/blog">
  <section class="blog-hero"><div class="shell"><p class="eyebrow">THE STREAM AUTH JOURNAL</p><h1>Notes for builders.</h1><p>Practical ideas on protecting, shipping, and growing software products.</p></div></section>
  <section class="blog-list shell">{posts.map((post, i) => <article class:list={['post-card', i === 0 && 'post-featured']}><div class="post-visual"><span>{post.category}</span><b>{String(i + 1).padStart(2, '0')}</b></div><div class="post-copy"><div><span>{post.category}</span><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></div><h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2><p>{post.description}</p><a class="text-link arrow-link" href={`/blog/${post.slug}`}>Read article →</a><small>{post.readingTime}</small></div></article>)}</section>
</BaseLayout>
